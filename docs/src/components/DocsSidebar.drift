<script>
  // Bug fix: `.sidebar-link.active` existed in both stylesheets but nothing
  // ever applied the `active` class, so the current page was never
  // highlighted in the docs sidebar. Compute it from the ambient `url`.
  // `url` is the raw pathname with no trailing slash (e.g. "/guide/introduction")
  // while every href here ends in "/" (site uses trailingSlash: 'always' in
  // drift.config.ts), so compare with trailing slashes stripped on both sides.
  function norm(p) {
    return p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p;
  }
  function cls(href) {
    return norm(url) === norm(href) ? 'sidebar-link active' : 'sidebar-link';
  }
  function current(href) {
    return norm(url) === norm(href) ? 'page' : undefined;
  }
</script>

