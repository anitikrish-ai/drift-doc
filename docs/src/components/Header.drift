<script>
  import ThemeToggle from '../components/ThemeToggle.drift';

  let { isRoot = false } = props;
  let hideHamburger = isRoot || url === '/' || url === '';

  // Highlight the current top-level section in the nav (bug fix: this was
  // never computed before, so `.nav-link.active` in docs.css was dead CSS).
  function navCls(section) {
    return url.indexOf(section) === 0 ? 'nav-link active' : 'nav-link';
  }
</script>

<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      @if !hideHamburger {
        <label for="nav-drawer-toggle" class="mobile-hamburger-btn" aria-label="Toggle Navigation Menu">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </label>
      }

      <a href="/" class="brand-link">
        <img src="/assets/icon.png" alt="DriftJS Logo" class="brand-logo-img" />
        <span class="brand-text">Drift<span class="brand-accent">JS</span></span>
      </a>
    </div>

    <nav class="header-nav">
      <a href="/guide/introduction/" class={navCls('/guide/')} aria-current={url.indexOf('/guide/') === 0 ? 'page' : undefined}>Guide</a>
      <a href="/architecture/virtual-machine/" class={navCls('/architecture/')} aria-current={url.indexOf('/architecture/') === 0 ? 'page' : undefined}>Architecture</a>
      <a href="/ssg/overview/" class={navCls('/ssg/')} aria-current={url.indexOf('/ssg/') === 0 ? 'page' : undefined}>SSG & Islands</a>
      <a href="/ecosystem/unplugin/" class={navCls('/ecosystem/')} aria-current={url.indexOf('/ecosystem/') === 0 ? 'page' : undefined}>Ecosystem</a>
      <a href="/api/compiler/" class={navCls('/api/')} aria-current={url.indexOf('/api/') === 0 ? 'page' : undefined}>API</a>
    </nav>

    <div class="header-actions">
      <button type="button" class="search-trigger" data-open-palette aria-label="Search documentation (Ctrl K)" aria-haspopup="dialog" aria-expanded="false" aria-controls="docs-search-palette">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>Search</span><kbd>⌘K</kbd>
      </button>
      <ThemeToggle client:load />
      <a href="https://github.com/driftjs-org/driftjs" target="_blank" rel="noopener noreferrer" class="github-btn" aria-label="GitHub Repository">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="header-mobile-drawer" id="mobile-nav-drawer">
    <div class="drawer-header">
      <div class="brand-link">
        <img src="/assets/icon.png" alt="DriftJS Logo" class="brand-logo-img" />
        <span class="brand-text">Drift<span class="brand-accent">JS</span></span>
      </div>
      <label for="nav-drawer-toggle" class="drawer-close-btn" aria-label="Close menu">&times;</label>
    </div>
    <nav class="drawer-nav">
      <div class="drawer-section-title">Navigation</div>
      <a href="/guide/introduction/" class="drawer-link">Documentation Guide</a>
      <a href="/architecture/virtual-machine/" class="drawer-link">VM Architecture</a>
      <a href="/ssg/overview/" class="drawer-link">SSG & Islands</a>
      <a href="/ecosystem/unplugin/" class="drawer-link">Ecosystem Tooling</a>
      <a href="/api/compiler/" class="drawer-link">API Reference</a>
      <a href="https://github.com/driftjs-org/driftjs" target="_blank" rel="noopener noreferrer" class="drawer-link">GitHub Repository</a>
    </nav>
  </div>
</header>
