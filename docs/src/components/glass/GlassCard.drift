<!-- Native DriftJS port of GlassCard. props: variant regular|clear, padding, radius -->
<script></script>
<div class={'lg-glass lg-glass--host lg-card lg-card--' + (props.variant || 'regular')} data-liquid-glass="" style={'padding:' + (props.padding || '24px') + ';border-radius:' + (props.radius || '28px')}>{children}</div>
