<!-- Native DriftJS port of GlassNav (tab bar). props: items (string[] labels), icons (string[] of emoji/glyphs, optional), value (index), ariaLabel. Selection handled by GlassUI (emits `glass-change`). -->
<script></script>
<div role="tablist" aria-label={props.ariaLabel} class="lg-track lg-track--tabbar" data-liquid-glass="" data-ready="" style={'--lg-count:' + props.items.length + ';--lg-index:' + (props.value || 0)}>
  <span class="lg-glass lg-track__glass" aria-hidden="true"></span>
  <span class="lg-track__select" aria-hidden="true"></span>
  @for (label, i) in props.items key i {
    <button type="button" role="tab" data-lg-item={i} aria-selected={i === (props.value || 0) ? 'true' : 'false'} tabindex={i === (props.value || 0) ? '0' : '-1'} class="lg-track__item">
      @if props.icons {
        <span class="lg-nav__icon" aria-hidden="true">{props.icons[i]}</span>
      }
      <span class="lg-nav__label">{label}</span>
    </button>
  }
  <span class="lg-glass lg-track__lens" aria-hidden="true"></span>
</div>
