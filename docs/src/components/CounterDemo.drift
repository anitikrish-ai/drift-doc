<script>
  let count = 0;
  let step = 1;
  const double = derive(() => count * 2);
  const isNegative = derive(() => count < 0);
  const isPositive = derive(() => count > 0);
  const isZero = derive(() => count === 0);
  const decText = derive(() => '- ' + step);
  const incText = derive(() => '+ ' + step);

  function increment() {
    count = count + step;
  }

  function decrement() {
    count = count - step;
  }

  function reset() {
    count = 0;
  }

  function setStep(newStep) {
    step = newStep;
  }
</script>

<div class="interactive-demo-widget">
  <div class="demo-widget-body">
    <div class="counter-display-card">
      <div class="counter-label">Current State</div>
      <div class="counter-value">{count}</div>
      <div class="counter-derived">
        Derived double: <span class="derived-highlight">{double}</span>
      </div>
      @if count < 0 {
        <div class="counter-notice negative">Notice: Value is currently negative!</div>
      } @else if count > 0 {
        <div class="counter-notice positive">Notice: Value is currently positive!</div>
      } @else {
        <div class="counter-notice zero">Notice: Value is currently zero</div>
      }
    </div>

    <div class="demo-controls">
      <div class="btn-group">
        <button class="lg-glass lg-button lg-button--md lg-button--filled" data-liquid-glass="" data-shimmer="" onclick={decrement}>{decText}</button>
        <button class="lg-glass lg-button lg-button--md lg-button--clear" data-liquid-glass="" data-shimmer="" onclick={reset}>Reset</button>
        <button class="lg-glass lg-button lg-button--md lg-button--filled" data-liquid-glass="" data-shimmer="" onclick={increment}>{incText}</button>
      </div>

      <div class="step-selector" role="group" aria-label="Step size">
        <span class="step-label">Step size:</span>
        <div class="lg-track lg-track--segmented lg-track--sm" data-liquid-glass="" data-ready="" style={'--lg-count:3;--lg-index:' + (step === 1 ? 0 : step === 5 ? 1 : 2)}>
          <span class="lg-glass lg-track__glass" aria-hidden="true"></span>
          <span class="lg-track__select" aria-hidden="true"></span>
          <button type="button" class="lg-track__item" data-lg-item="0" aria-pressed={step === 1} onclick={() => setStep(1)}><span class="lg-nav__label">1</span></button>
          <button type="button" class="lg-track__item" data-lg-item="1" aria-pressed={step === 5} onclick={() => setStep(5)}><span class="lg-nav__label">5</span></button>
          <button type="button" class="lg-track__item" data-lg-item="2" aria-pressed={step === 10} onclick={() => setStep(10)}><span class="lg-nav__label">10</span></button>
          <span class="lg-glass lg-track__lens" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</div>
